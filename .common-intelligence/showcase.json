    "zh": "Grandmaster-CI v0.1.0 — Phase 0 真实引擎与对弈展示区"
  },
  "visualizationGoal": {
    "en": "Display the clean-room chess engine's real benchmark games, interactive board replay, move-by-move centipawn evaluation, real Elo progression, W/D/L rates, depth/NPS telemetry, and optional live classical search/eval optimization runs directly from the repository.",
    "zh": "展示洁净室国际象棋引擎的真实基准对弈、交互式棋盘与棋谱回放、逐着厘兵评估、实测 Elo 变化曲线、胜和负率、搜索深度与速度（NPS），并支持在浏览器中启动真实的传统搜索/评估优化实验或人机对弈。"
  },
  "dataEndpoint": "/api/challenges/grandmaster/showcase",
  "refreshMode": "poll",
  "permissions": ["allow-scripts", "allow-pointer-lock"],
  "build": {
    "command": "node --experimental-strip-types packages/grandmaster-engine/src/run-baseline.ts",
